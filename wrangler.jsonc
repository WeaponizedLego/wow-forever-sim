// Cloudflare Workers Builds deploys the static site with Workers static assets (no Worker script).
// Build command: pnpm build   → apps/web/.output/public (engine staged from the release in engine.lock.json)
// Deploy command: npx wrangler deploy (Cloudflare's default) reads this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wow-forever-sim",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/web/.output/public",
    // Every route renders client-side from the app shell: unknown paths (/runs/0004, /s#…) get index.html, 200.
    "not_found_handling": "single-page-application",
  },
}
