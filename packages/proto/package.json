{
  "name": "@fsim/proto",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from the pinned upstream engine's .proto files. Regenerated by the engine-sync pipeline; do not edit src/generated by hand.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/generated/*.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
