# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Headers from every matching rule are combined, so the rules below must not overlap.
# HTML keeps the Pages default (max-age=0, must-revalidate + ETag): a deploy shows up on the next load.

# Hashed build assets. `:file` is one path segment, so /_nuxt/builds/* (Nuxt's per-deploy app manifest)
# keeps the default revalidation.
/_nuxt/:file
  Cache-Control: public, max-age=31536000, immutable

# Engine files are immutable per engine id (scripts/stage-engine.mjs).
# lib.wasm.gz needs no rule: the engine loader gunzips it itself and checks the sha256 of the .gz bytes, so it
# must arrive as-is, and Pages already serves .gz as `Content-Type: application/gzip` without Content-Encoding.
# That is exactly how upstream's own Pages site serves www.wowsims.com/forever/lib.wasm.gz. Setting
# Content-Type here would be merged with the default, so it is left alone.
/engine/:id/*
  Cache-Control: public, max-age=31536000, immutable

# Names the current engine id: always revalidate.
/engine/current.json
  Cache-Control: no-cache

# A new service worker must be picked up on the next visit.
/sw.js
  Cache-Control: no-cache
